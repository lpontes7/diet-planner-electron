{
  "name": "dietas-app",
  "productName": "DietasApp",
  "version": "1.0.1",
  "private": true,
  "description": "Planejamento alimentar offline com fidelidade à planilha original",
  "author": "Lucas Pontes",
  "license": "UNLICENSED",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.cjs",
    "build": "vite build --config vite.main.config.mts && vite build --config vite.preload.config.mts && vite build --config vite.renderer.config.mts",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:windows": "electron-forge make --platform win32 --arch x64",
    "make:windows:linux": "bash scripts/make-windows-linux.sh"
  },
  "config": {
    "forge": "./forge.config.mts"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/asar": "^4.3.2",
    "@electron/fuses": "^2.1.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^22.0.0",
    "electron": "45.3.3",
    "playwright": "^1.58.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.0.0"
  }
}
